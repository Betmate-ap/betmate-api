# ─── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml — run `docker compose up db -d` to start the DB
DATABASE_URL=postgresql://betmate:betmate@localhost:5432/betmate

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Any string works for local dev — must be a strong secret in staging/production
JWT_SECRET=dev-secret-change-me

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the frontend dev server (Vite default is 5173)
CORS_ORIGIN=http://localhost:5173

# ─── Monitoring (optional) ────────────────────────────────────────────────────
# SENTRY_DSN=
