    {
      "name": "Auth",
      "description": "Authentication flows. Signup and Login automatically capture `accessToken`, `refreshToken`, `userId`, and `userEmail` into collection variables — subsequent requests use them with no manual copying.",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Signup($input: SignupInput!) {\n  signup(input: $input) {\n    accessToken\n    refreshToken\n    user {\n      id\n      email\n      username\n      firstName\n      lastName\n      emailVerified\n      isActive\n      createdAt\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"{{$randomEmail}}\",\n    \"username\": \"user_{{$randomInt}}\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\",\n    \"password\": \"Test123!\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Create a new account. Uses Postman dynamic variables (`{{$randomEmail}}`, `{{$randomInt}}`) so every run generates a unique user — no duplicate email errors.\n\n**Auto-captures:** `accessToken`, `refreshToken`, `userId`, `userEmail`"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Returns accessToken\", () => pm.expect(json.data.signup.accessToken).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Returns refreshToken\", () => pm.expect(json.data.signup.refreshToken).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Returns user with id\", () => pm.expect(json.data.signup.user.id).to.exist);",
                  "pm.test(\"User email matches input\", () => pm.expect(json.data.signup.user.email).to.be.a(\"string\"));",
                  "",
                  "if (json.data && json.data.signup) {",
                  "  const { accessToken, refreshToken, user } = json.data.signup;",
                  "  pm.collectionVariables.set(\"accessToken\", accessToken);",
                  "  pm.collectionVariables.set(\"refreshToken\", refreshToken);",
                  "  pm.collectionVariables.set(\"userId\", user.id);",
                  "  pm.collectionVariables.set(\"userEmail\", user.email);",
                  "  console.log(\"Captured accessToken for:\", user.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($input: LoginInput!) {\n  login(input: $input) {\n    accessToken\n    refreshToken\n    user {\n      id\n      email\n      username\n      firstName\n      lastName\n      emailVerified\n      isActive\n      lastLogin\n      createdAt\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"Test123!\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Login with existing credentials. Uses `{{userEmail}}` captured from Signup — or replace with a fixed email.\n\n**Auto-captures:** `accessToken`, `refreshToken` (rotated on every login)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Returns accessToken\", () => pm.expect(json.data.login.accessToken).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Returns refreshToken\", () => pm.expect(json.data.login.refreshToken).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Returns user with id\", () => pm.expect(json.data.login.user.id).to.exist);",
                  "",
                  "if (json.data && json.data.login) {",
                  "  const { accessToken, refreshToken, user } = json.data.login;",
                  "  pm.collectionVariables.set(\"accessToken\", accessToken);",
                  "  pm.collectionVariables.set(\"refreshToken\", refreshToken);",
                  "  pm.collectionVariables.set(\"userId\", user.id);",
                  "  pm.collectionVariables.set(\"userEmail\", user.email);",
                  "  console.log(\"Logged in as:\", user.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (Authenticated)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Me {\n  me {\n    id\n    email\n    username\n    firstName\n    lastName\n    avatar\n    emailVerified\n    isActive\n    lastLogin\n    createdAt\n    updatedAt\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Fetch the currently authenticated user. Uses `{{accessToken}}` from collection-level Bearer auth — set automatically by Signup or Login.\n\nReturns `null` if token is missing or expired."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Returns authenticated user\", () => {",
                  "  pm.expect(json.data.me).to.not.be.null;",
                  "  pm.expect(json.data.me.id).to.equal(pm.collectionVariables.get(\"userId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "refreshToken={{refreshToken}}", "description": "Manually set cookie — Postman does not auto-send cookies from Set-Cookie headers in the same way browsers do. Replace with the actual refreshToken value if needed." }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RefreshToken {\n  refreshToken {\n    accessToken\n    refreshToken\n    user {\n      id\n      email\n      username\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Exchange the refresh token for a new access token. The refresh token is sent via HTTP-only cookie.\n\n**Note:** The Cookie header here manually forwards `{{refreshToken}}` captured during Login/Signup. In a real browser, this cookie is sent automatically.\n\n**Auto-captures:** Rotated `accessToken` and `refreshToken`"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Returns new accessToken\", () => pm.expect(json.data.refreshToken.accessToken).to.be.a(\"string\").and.not.empty);",
                  "",
                  "if (json.data && json.data.refreshToken) {",
                  "  const { accessToken, refreshToken } = json.data.refreshToken;",
                  "  pm.collectionVariables.set(\"accessToken\", accessToken);",
                  "  pm.collectionVariables.set(\"refreshToken\", refreshToken);",
                  "  console.log(\"Tokens rotated successfully\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "refreshToken={{refreshToken}}" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Logout {\n  logout\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Invalidate the current session. Clears the refresh token from the database and revokes the cookie.\n\n**Auto-clears:** `accessToken`, `refreshToken` collection variables after success."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Logout returns true\", () => pm.expect(json.data.logout).to.be.true);",
                  "",
                  "pm.collectionVariables.set(\"accessToken\", \"\");",
                  "pm.collectionVariables.set(\"refreshToken\", \"\");",
                  "console.log(\"Tokens cleared from collection variables\");"
                ]
              }
            }
          ]
        },
        {
