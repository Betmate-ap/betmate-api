                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Health returns ok\", () => pm.expect(json.data.health).to.equal(\"ok\"));"
                ]
